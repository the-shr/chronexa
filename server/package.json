{
  "name": "chronexa-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "db:migrate": "prisma migrate deploy",
    "db:new-migration": "node scripts/new-migration.js",
    "db:seed": "node scripts/seed.js",
    "setup": "prisma migrate deploy && node scripts/seed.js",
    "test": "npm run test:api && npm run test:admin && npm run test:hardening && npm run test:storage && npm run test:profile",
    "test:api": "node --env-file=.env scripts/api-smoke.js",
    "test:admin": "node --env-file=.env scripts/admin-smoke.js",
    "test:hardening": "node scripts/hardening-smoke.js",
    "test:storage": "node --env-file=.env scripts/storage-smoke.js",
    "test:profile": "node --env-file=.env scripts/profile-smoke.js",
    "clear:demo": "node --env-file=.env scripts/clear-demo-data.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@prisma/client": "^6.2.1",
    "@upstash/redis": "^1.34.3",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  }
}
