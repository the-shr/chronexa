generator client {
  provider = "prisma-client-js"
}

// Postgres, because the app deploys to Vercel where there is no persistent
// filesystem for SQLite to live on.
//
// DATABASE_URL should be the *pooled* connection string (Neon's -pooler host,
// or Vercel Postgres' POSTGRES_PRISMA_URL): serverless functions open far more
// connections than a Postgres instance will accept directly.
// DIRECT_URL is the unpooled string, used only for migrations.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("employee") // employee | admin
  active       Boolean  @default(true)
  // Storage reference for the profile picture, in the same form as a
  // screenshot's: `r2:<key>` or a relative path. Null means use initials.
  avatarPath   String?
  createdAt    DateTime @default(now())

  devices     Device[]
  sessions    WorkSession[]
  screenshots Screenshot[]
  recordings  Recording[]
  tasks       Task[]        @relation("AssignedTasks")
}

model Device {
  id         String    @id @default(cuid())
  userId     String
  name       String
  platform   String    @default("unknown")
  token      String    @unique
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions WorkSession[]

  @@index([userId])
}

model WorkSession {
  id              String    @id // uuid generated by the desktop agent
  userId          String
  deviceId        String?
  taskId          String?
  startedAt       DateTime
  endedAt         DateTime?
  activeSeconds   Int       @default(0)
  idleSeconds     Int       @default(0)
  taskNote        String    @default("")
  stopReason      String?
  screenshotCount Int       @default(0)
  updatedAt       DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device      Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  screenshots Screenshot[]
  recordings  Recording[]

  @@index([userId, startedAt])
}

model Task {
  id          String    @id @default(cuid())
  userId      String // who it is assigned to
  title       String
  description String    @default("")
  status      String    @default("open") // open | done
  priority    String    @default("normal") // low | normal | high
  // "assigned" came from an admin; "self" the employee added themselves. Only
  // self tasks may be deleted from the agent.
  source      String    @default("assigned")
  // The employee's own ordering of their list. Lower sorts first.
  position    Int       @default(0)
  dueAt       DateTime?
  estimateMinutes Int?
  completedAt DateTime?
  createdById String? // the admin who assigned it
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User          @relation("AssignedTasks", fields: [userId], references: [id], onDelete: Cascade)
  sessions WorkSession[]

  @@index([userId, status])
}

model Screenshot {
  id              String   @id @default(cuid())
  // Agent-side id. Timestamp based, so it is only unique per user.
  clientId        String
  userId          String
  sessionId       String?
  capturedAt      DateTime
  monitorIndex    Int      @default(0)
  monitorLabel    String   @default("")
  width           Int      @default(0)
  height          Int      @default(0)
  bytes           Int      @default(0)
  activityPercent Int?
  blurred         Boolean  @default(false)
  storagePath     String
  createdAt       DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session WorkSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId])
  @@index([userId, capturedAt])
}

/// Short screen clips, stored in Google Drive rather than R2 -- only the id of
/// the Drive file is kept here. Recorded only when an admin turns it on.
model Recording {
  id          String   @id @default(cuid())
  /// Agent-side id, so a retried upload does not create a duplicate.
  clientId    String
  userId      String
  sessionId   String?
  startedAt   DateTime
  durationMs  Int      @default(0)
  width       Int      @default(0)
  height      Int      @default(0)
  bytes       Int      @default(0)
  mimeType    String   @default("video/webm")
  /// Google Drive file id. Empty while an upload is still being retried.
  driveFileId String
  createdAt   DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session WorkSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId])
  @@index([userId, startedAt])
}
