generator client {
  provider = "prisma-client-js"
}

// Postgres, because the app deploys to Vercel where there is no persistent
// filesystem for SQLite to live on.
//
// DATABASE_URL should be the *pooled* connection string (Neon's -pooler host,
// or Vercel Postgres' POSTGRES_PRISMA_URL): serverless functions open far more
// connections than a Postgres instance will accept directly.
// DIRECT_URL is the unpooled string, used only for migrations.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  // Null for accounts mirrored from Brand Macros OS: the ecosystem hub owns
  // their password, so nothing to store or verify here. Local accounts (the
  // break-glass admin) keep a real scrypt hash.
  passwordHash String?
  role         String   @default("employee") // employee | admin
  active       Boolean  @default(true)
  // "local" for accounts created in Chronexa, "bmos" for ones mirrored from the
  // ecosystem hub on first sign-in.
  source       String   @default("local")
  // The Brand Macros OS user id, when this account is mirrored from there.
  externalId   String?  @unique
  bmosRoleKeys String[] @default([])
  bmosPermissions String[] @default([])
  bmosIsSuperAdmin Boolean @default(false)
  // Storage reference for the profile picture, in the same form as a
  // screenshot's: `r2:<key>` or a relative path. Null means use initials.
  avatarPath   String?
  createdAt    DateTime @default(now())

  /// Per-person policy overrides as a partial of the org policy: any key present
  /// wins over the organisation default, anything absent falls back to it. Null
  /// or {} means "entirely on the team default", so a team where everyone is the
  /// same needs nothing here. This is what lets one person be tracked with no
  /// screenshots or recording while the rest are captured normally.
  overrides Json?

  devices     Device[]
  sessions    WorkSession[]
  screenshots Screenshot[]
  recordings  Recording[]
  tasks       Task[]        @relation("AssignedTasks")
}

model Device {
  id         String    @id @default(cuid())
  userId     String
  name       String
  platform   String    @default("unknown")
  token      String    @unique
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions WorkSession[]

  @@index([userId])
}

model WorkSession {
  id              String    @id // uuid generated by the desktop agent
  userId          String
  deviceId        String?
  taskId          String?
  externalTaskId  String?
  startedAt       DateTime
  endedAt         DateTime?
  activeSeconds   Int       @default(0)
  idleSeconds     Int       @default(0)
  taskNote        String    @default("")
  stopReason      String?
  screenshotCount Int       @default(0)
  updatedAt       DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device      Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  screenshots Screenshot[]
  recordings  Recording[]

  @@index([userId, startedAt])
  @@index([startedAt])
  @@index([updatedAt])
}

model Task {
  id          String    @id @default(cuid())
  userId      String // who it is assigned to
  title       String
  description String    @default("")
  status      String    @default("open") // open | done
  priority    String    @default("normal") // low | normal | high
  // "assigned" came from an admin; "self" the employee added themselves. Only
  // self tasks may be deleted from the agent.
  source      String    @default("assigned")
  // The employee's own ordering of their list. Lower sorts first.
  position    Int       @default(0)
  dueAt       DateTime?
  estimateMinutes Int?
  completedAt DateTime?
  createdById String? // the admin who assigned it
  externalId   String?  @unique
  parentExternalId String?
  parentTitle  String?
  projectExternalId String?
  projectName  String?
  clientExternalId String?
  clientName   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User          @relation("AssignedTasks", fields: [userId], references: [id], onDelete: Cascade)
  sessions WorkSession[]

  @@index([userId, status])
}

model Screenshot {
  id              String   @id @default(cuid())
  // Agent-side id. Timestamp based, so it is only unique per user.
  clientId        String
  userId          String
  sessionId       String?
  capturedAt      DateTime
  monitorIndex    Int      @default(0)
  monitorLabel    String   @default("")
  width           Int      @default(0)
  height          Int      @default(0)
  bytes           Int      @default(0)
  activityPercent Int?
  blurred         Boolean  @default(false)
  storagePath     String
  createdAt       DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session WorkSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId])
  @@index([userId, capturedAt])
  @@index([capturedAt])
}

/// What the organisation monitors and expects, set by an admin and obeyed by
/// every agent. A single row, id "org".
///
/// This lives here rather than in each agent's settings file so an admin can
/// change it without touching anyone's machine -- and so an employee cannot
/// change what is monitored by editing a file on their own computer.
model Policy {
  id String @id @default("org")

  /// Office hours as "HH:MM" in the employee's own timezone, and the working
  /// days as ISO weekday numbers. Used for reporting, not for blocking: someone
  /// working late is worth showing an admin, not worth refusing to record.
  officeStart String @default("09:00")
  officeEnd   String @default("17:00")
  workDays    String @default("1,2,3,4,5")

  dailyTargetHours  Float @default(8)
  weeklyTargetHours Float @default(40)

  idleThresholdMinutes Int     @default(5)
  idleOnTimeout        String  @default("pause") // pause | stop
  countIdleAsWork      Boolean @default(false)

  screenshotsEnabled        Boolean @default(true)
  screenshotIntervalMinutes Int     @default(10)
  screenshotRandomize       Boolean @default(true)
  screenshotQuality         Int     @default(60)
  screenshotAllMonitors     Boolean @default(true)
  screenshotBlur            Boolean @default(false)

  recordingEnabled          Boolean @default(false)
  /// "interval" takes a short clip every so often; "session" records
  /// continuously in segments for as long as someone is working.
  recordingMode             String  @default("interval")
  recordingIntervalMinutes  Int     @default(3)
  recordingDurationSeconds  Int     @default(5)
  /// Segment length in session mode. Long clips risk losing everything to one
  /// failed upload, so continuous recording is cut into pieces.
  recordingSegmentMinutes   Int     @default(5)
  recordingMaxWidth         Int     @default(1280)
  recordingFrameRate        Int     @default(12)

  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// Short screen clips, stored in Google Drive rather than R2 -- only the id of
/// the Drive file is kept here. Recorded only when an admin turns it on.
model Recording {
  id          String   @id @default(cuid())
  /// Agent-side id, so a retried upload does not create a duplicate.
  clientId    String
  userId      String
  sessionId   String?
  startedAt   DateTime
  durationMs  Int      @default(0)
  width       Int      @default(0)
  height      Int      @default(0)
  bytes       Int      @default(0)
  mimeType    String   @default("video/webm")
  /// Google Drive file id. Empty while an upload is still being retried.
  driveFileId String
  createdAt   DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session WorkSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId])
  @@index([userId, startedAt])
  @@index([startedAt])
}
