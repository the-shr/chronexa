// SQLite keeps local setup to a single file. Switching to Postgres/Neon later
// is a provider change plus a fresh migration -- no model changes required.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("employee") // employee | admin
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  devices     Device[]
  sessions    WorkSession[]
  screenshots Screenshot[]
}

model Device {
  id         String    @id @default(cuid())
  userId     String
  name       String
  platform   String    @default("unknown")
  token      String    @unique
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions WorkSession[]

  @@index([userId])
}

model WorkSession {
  id              String    @id // uuid generated by the desktop agent
  userId          String
  deviceId        String?
  startedAt       DateTime
  endedAt         DateTime?
  activeSeconds   Int       @default(0)
  idleSeconds     Int       @default(0)
  taskNote        String    @default("")
  stopReason      String?
  screenshotCount Int       @default(0)
  updatedAt       DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device      Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  screenshots Screenshot[]

  @@index([userId, startedAt])
}

model Screenshot {
  id              String   @id @default(cuid())
  // Agent-side id. Timestamp based, so it is only unique per user.
  clientId        String
  userId          String
  sessionId       String?
  capturedAt      DateTime
  monitorIndex    Int      @default(0)
  monitorLabel    String   @default("")
  width           Int      @default(0)
  height          Int      @default(0)
  bytes           Int      @default(0)
  activityPercent Int?
  blurred         Boolean  @default(false)
  storagePath     String
  createdAt       DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session WorkSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId])
  @@index([userId, capturedAt])
}
