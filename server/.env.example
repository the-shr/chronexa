# Copy to .env before running the server.

# ---------------------------------------------------------------- database --
# Postgres. Use the POOLED connection string here -- serverless functions open
# far more connections than Postgres accepts directly.
#   Neon:            postgresql://...@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
#   Vercel Postgres: the value of POSTGRES_PRISMA_URL
DATABASE_URL=""

# The UNPOOLED connection string. Used only by `prisma migrate` / `db push`.
#   Neon:            same host without "-pooler"
#   Vercel Postgres: the value of POSTGRES_URL_NON_POOLING
DIRECT_URL=""

# ------------------------------------------------------------------- auth --
# Signs the admin session cookie. Must be at least 32 characters, and the
# server refuses to start if it is missing or still the example value below.
# Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------- storage --
# "local" — writes to UPLOAD_DIR. Development, or a VPS with a real disk.
# "r2"    — Cloudflare R2. Required on Vercel; the filesystem there does not
#           persist. Any S3-compatible service works via R2_ENDPOINT.
# Leave unset to pick "r2" automatically once the R2 variables below are set.
STORAGE_DRIVER="local"

# Only used by the "local" driver.
UPLOAD_DIR="./uploads"

# Cloudflare R2. Objects stay private -- images are streamed through
# /api/image/:id behind an admin session, never served from the bucket.
#
# Use a bucket dedicated to this app, with an R2 API token scoped to that
# bucket only. Sharing a bucket with another app means its tooling can delete
# these screenshots, and sharing a token means a breach in either app exposes
# both. Extra buckets are free; you pay for storage and operations either way.
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""

# Key prefix inside the bucket.
# R2_PREFIX="chronexa"

# ----------------------------------------------------------- rate limiting --
# Without these, rate limit counters live in process memory -- fine for a single
# server, useless on Vercel where each instance counts separately, because an
# attacker's attempts spread across instances and no single one ever sees enough
# to trip the limit.
#
# Set up (free tier is ample -- the limiter does a couple of commands per login):
#   1. console.upstash.com -> Create Database -> Redis
#   2. pick the region closest to your Vercel deployment
#   3. on the database page, "REST API" -> copy UPSTASH_REDIS_REST_URL and
#      UPSTASH_REDIS_REST_TOKEN
#   4. paste them below, then run `npm run test:upstash` to prove it works
#   5. set the same two variables in the Vercel project's environment
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Set to "true" behind a reverse proxy (Vercel, nginx, Cloudflare) so rate
# limiting reads the real client IP from x-forwarded-for.
TRUST_PROXY="false"

# --------------------------------------------------- screenshot retention --
# Delete screenshots older than this many days. Unset or 0 keeps them forever.
# The purge runs daily on Vercel via cron (see vercel.json) or by hand with
# `npm run purge:screenshots`.
# SCREENSHOT_RETENTION_DAYS="30"

# Required for the daily purge cron. Vercel sends this as a Bearer token; the
# endpoint refuses to run without it. Use a long random string.
# CRON_SECRET=""

# ------------------------------------------------- screen recording (Drive) --
# Where the 5-second clips are stored. Free: the Drive API costs nothing and
# needs no billing account. The clips use the admin's own Drive quota (15 GB on
# a free Google account), so keep RECORDING_RETENTION_DAYS short.
#
# Set up:
#   1. console.cloud.google.com -> new project (any name)
#   2. "APIs & Services" -> Library -> search "Google Drive API" -> Enable
#   3. "APIs & Services" -> OAuth consent screen
#        User type: External
#        fill in app name and your email
#        Scopes: add .../auth/drive.file  (narrow -- this app can only ever see
#        the files it created, never the rest of your Drive)
#        then Publish the app, so the refresh token does not expire weekly
#   4. "APIs & Services" -> Credentials -> Create credentials
#        -> OAuth client ID -> Application type: Desktop app
#        copy the client id and secret into the two lines below
#   5. run: npm run drive:connect
#        approve in the browser; it prints the refresh token and folder id
#   6. paste those two lines here, then: npm run test:drive
#   7. set all four in Vercel too
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REFRESH_TOKEN=""
# GOOGLE_DRIVE_FOLDER_ID=""

# Delete recordings older than this many days, from Drive and the database.
# Unset or 0 keeps them forever, which will fill a free Drive in about a
# fortnight. Runs in the same daily cron as the screenshot purge.
# RECORDING_RETENTION_DAYS="14"

# ---------------------------------------------------------------- seeding --
# Optional: override the seeded accounts (see scripts/seed.js).
# Passwords must be 10+ characters with both letters and numbers.
# SEED_ADMIN_EMAIL="admin@yourcompany.com"
# SEED_ADMIN_PASSWORD=""
# SEED_EMPLOYEE_EMAIL="employee@yourcompany.com"
# SEED_EMPLOYEE_PASSWORD=""
