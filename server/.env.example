# Copy to .env before running the server.

# SQLite for local development. For production swap the provider in
# prisma/schema.prisma to "postgresql" and point this at your database.
DATABASE_URL="file:./dev.db"

# Signs the admin session cookie. Must be at least 32 characters, and the
# server refuses to start if it is missing or still the example value below.
# Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Where uploaded screenshots are written. Use a persistent volume in production.
UPLOAD_DIR="./uploads"

# Set to "true" when running behind a reverse proxy (nginx, Vercel, Cloudflare)
# so rate limiting reads the real client IP from x-forwarded-for.
TRUST_PROXY="false"

# Optional: override the seeded accounts (see scripts/seed.js).
# Passwords must be 10+ characters with both letters and numbers.
# SEED_ADMIN_EMAIL="admin@yourcompany.com"
# SEED_ADMIN_PASSWORD=""
# SEED_EMPLOYEE_EMAIL="employee@yourcompany.com"
# SEED_EMPLOYEE_PASSWORD=""
